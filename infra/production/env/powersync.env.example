# powersync.env — private Einstellungen von PowerSync.
# Eigenes Replikations-Login: Recht REPLICATION, nur SELECT auf die publizierten Tabellen, kein Zugriff auf das auth-Schema.
PS_DATA_SOURCE_URI=postgres://clinks_replication:PASSWORT@db.intern:5432/clinks
# Eigene, beschreibbare Datenbank für die Metadaten von PowerSync (nicht die Anwendungsdatenbank).
PS_STORAGE_SOURCE_URI=postgres://powersync:PASSWORT@db.intern:5432/powersync_storage
# Öffentliche Schlüssel der API (wie JWKS_URL in collab.env).
PS_JWKS_URI=https://api.clinks.ch/.well-known/jwks.json
# Zufällig, mindestens 32 Zeichen: openssl rand -hex 32
PS_ADMIN_TOKEN=
