# api.env — private Einstellungen der API. Nach CONFIG_DIR/api.env kopieren (ausserhalb des Repos), nie committen.
# Prüfen mit: pnpm ops:check -- --config-dir /pfad/zu/CONFIG_DIR

# --- Datenbank ---------------------------------------------------------------------------------------------
# Login clinks_api: Mitglied von clinks_app, kein Eigentümer, kein Superuser, kein BYPASSRLS. TLS mit Zertifikatsprüfung.
DATABASE_URL=postgres://clinks_api:PASSWORT@db.intern:5432/clinks?sslmode=verify-full

# --- Öffentliche Adressen ----------------------------------------------------------------------------------
# Wo die Web-App läuft (CORS, Links in Mails) und wo die API von aussen erreichbar ist (Aussteller der Tokens).
WEB_ORIGIN=https://app.clinks.ch
TOKEN_ISSUER=https://api.clinks.ch
TOKEN_AUDIENCE=clinks

# --- Schlüssel ---------------------------------------------------------------------------------------------
# Beide mit `pnpm --filter @clinks/api keys` erzeugen. SIGNING_KEY in einfachen Anführungszeichen.
# Bei einem Wechsel des SIGNING_KEY den alten öffentlichen Schlüssel 30 Tage in PREVIOUS_PUBLIC_KEYS behalten.
SIGNING_KEY='{"kty":"OKP","crv":"Ed25519","x":"…","d":"…","kid":"clinks-2026-11-24","alg":"EdDSA"}'
PREVIOUS_PUBLIC_KEYS=[]
# Verschlüsselt die S3-Schlüssel der Mandanten. Nie ändern, solange Mandanten eigene Buckets verbunden haben.
STORAGE_SECRET_KEY=

# --- Dokumenten-Bucket (Infomaniak Object Storage) ---------------------------------------------------------
# Öffentlicher HTTPS-Endpoint (der Browser lädt direkt hoch), Bucket mit Versionierung und Object Lock.
S3_ENDPOINT=https://s3.pub1.infomaniak.cloud
S3_BUCKET=clinks-dokumente
S3_REGION=dc3-a
# EC2-Zugangsdaten eines Benutzers, der nur diesen Bucket nutzen darf.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- E-Mail ------------------------------------------------------------------------------------------------
# Anmeldecodes, Einladungen, Passwort-Links. Port 465 mit TLS.
SMTP_URL=smtps://no-reply%40clinks.ch:PASSWORT@mail.infomaniak.com:465
MAIL_FROM=CLinks <no-reply@clinks.ch>

# --- Zahlungen (Stripe) ------------------------------------------------------------------------------------
# Zuerst sk_test_ zum Ausprobieren, für echte Abos sk_live_. STRIPE_PRICES = Ausgabe von billing-catalog.ts.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICES=
# Erst einschalten, wenn in Stripe die MWST-Registrierung eingerichtet ist.
STRIPE_TAX=false
