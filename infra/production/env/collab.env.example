# collab.env — private Einstellungen des Kollaborations-Servers (Live-Präsenz, gemeinsame Notizen).
# Gleiches eingeschränktes Login wie die API.
DATABASE_URL=postgres://clinks_api:PASSWORT@db.intern:5432/clinks?sslmode=verify-full
# Muss mit api.env übereinstimmen.
TOKEN_ISSUER=https://api.clinks.ch
TOKEN_AUDIENCE=clinks
# Öffentliche Schlüssel der API, damit der Server die Tokens prüfen kann.
JWKS_URL=https://api.clinks.ch/.well-known/jwks.json
