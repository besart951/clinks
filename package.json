{
  "name": "clinks",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26.13.0",
    "pnpm": ">=12.21.0"
  },
  "scripts": {
    "dev": "pnpm --filter @clinks/web dev",
    "dev:api": "pnpm --filter @clinks/api dev",
    "dev:services": "docker compose -f infra/compose.dev.yml up -d",
    "dev:services:down": "docker compose -f infra/compose.dev.yml down",
    "db:migrate": "DATABASE_OWNER_URL=${DATABASE_OWNER_URL:-postgres://clinks:clinks-dev@localhost:5432/clinks} pnpm --filter @clinks/db migrate",
    "check": "pnpm -r check",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @clinks/db --filter @clinks/api test:integration",
    "test:e2e": "pnpm --filter @clinks/web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:translations": "node scripts/generate-translation-catalog.mjs",
    "check:translations": "node scripts/generate-translation-catalog.mjs --check",
    "build": "pnpm -r build",
    "build:artifact": "pnpm --filter @clinks/web build:artifact",
    "verify": "pnpm format:check && pnpm lint && pnpm check:translations && pnpm check:openapi && node apps/mobile/tool/generate.mjs --check && pnpm check && pnpm test && pnpm build",
    "check:openapi": "pnpm --filter @clinks/api openapi --check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
