{
  "name": "@clinks/ui-shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./theme-toggle": {
      "svelte": "./src/lib/ThemeToggle.svelte",
      "default": "./src/lib/ThemeToggle.svelte"
    },
    "./language-selector": {
      "svelte": "./src/lib/LanguageSelector.svelte",
      "default": "./src/lib/LanguageSelector.svelte"
    },
    "./toaster": {
      "svelte": "./src/lib/components/ui/sonner/index.ts",
      "default": "./src/lib/components/ui/sonner/index.ts"
    },
    "./styles": "./src/styles.css",
    "./utils": "./src/lib/utils.ts",
    "./utils.js": "./src/lib/utils.ts",
    "./components/ui/*": {
      "svelte": "./src/lib/components/ui/*/index.ts",
      "default": "./src/lib/components/ui/*/index.ts"
    }
  },
  "peerDependencies": {
    "svelte": "^5.56.4"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.2",
    "@lucide/svelte": "^1.27.0",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "svelte-sonner": "^1.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.0",
    "tw-animate-css": "^1.4.0"
  }
