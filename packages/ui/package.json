{
  "name": "@clinks/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./toaster": {
      "svelte": "./src/lib/components/ui/sonner/index.ts",
      "default": "./src/lib/components/ui/sonner/index.ts"
    },
    "./styles": "./src/styles.css",
    "./utils": "./src/lib/utils.ts",
    "./utils.js": "./src/lib/utils.ts",
    "./components/ui/*": {
      "svelte": "./src/lib/components/ui/*/index.ts",
      "default": "./src/lib/components/ui/*/index.ts"
    },
    "./components/ui/*/*": {
      "svelte": "./src/lib/components/ui/*/*.svelte",
      "default": "./src/lib/components/ui/*/*.svelte"
    },
    "./kit/avatar": "./src/lib/kit/avatar.ts",
    "./kit/inline-edit": "./src/lib/kit/inline-edit.svelte.ts",
    "./kit/*": {
      "svelte": "./src/lib/kit/*",
      "default": "./src/lib/kit/*"
    },
    "./kit.css": "./src/kit.css"
  },
  "peerDependencies": {
    "svelte": "^5.59.1"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "@lucide/svelte": "1.77.0",
    "bits-ui": "2.21.0",
    "clsx": "2.1.1",
    "svelte-sonner": "1.2.3",
    "tailwind-merge": "3.7.1",
    "tailwind-variants": "3.3.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "svelte": "5.59.1",
    "tailwindcss": "4.3.5"
  }
}
