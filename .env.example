POSTGRES_DB=clinks
POSTGRES_USER=clinks_bootstrap
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_USER=clinks
DATABASE_PASSWORD=replace-with-a-different-long-random-password

DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=2
DATABASE_CONN_MAX_LIFETIME=1h
DATABASE_CONN_MAX_IDLE_TIME=30m
DATABASE_HEALTH_CHECK_PERIOD=1m

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_TTL=15m

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-admin-password
ADMIN_LOCALE=de-CH

SERVER_PORT=8080
SESSION_COOKIE_NAME=clinks_session
SESSION_COOKIE_SECURE=false
INVITE_PUBLIC_BASE_URL=http://localhost:5174
INVITE_TTL=168h
INVITATION_TOKEN_SECRET=replace-with-at-least-32-random-characters

# Required by worker run; API and worker healthcheck do not construct SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REQUIRE_TLS=true

# Optional Google OIDC. All values are required together when enabled.
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_CALLBACK_URL=
OIDC_STATE_SECRET=replace-with-at-least-32-random-characters
OIDC_SUCCESS_URL=
