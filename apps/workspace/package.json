{
  "name": "@clinks/workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:artifact": "WORKSPACE_ARTIFACT=1 vite build && node scripts/finalize-artifact.mjs",
    "preview": "vite preview",
