    "@lucide/svelte": "^1.27.0",
    "bits-ui": "^2.20.0",
    "qrcode": "^1.5.4",
    "svelte-sonner": "^1.1.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.5",
    "svelte": "^5.56.4",
    "svelte-check": "^4.3.4",
