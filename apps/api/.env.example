# Copy to apps/api/.env for `pnpm dev:api`. Every value has a development default (src/config.ts).
# DATABASE_URL=postgres://clinks_api:clinks-api-dev@localhost:5432/clinks
# WEB_ORIGIN=http://localhost:5176
# ALLOWED_ORIGINS=https://desktop.clinks.ch,http://tauri.localhost
# SMTP_URL=smtp://localhost:1025
# Relay for workspaces' own sender domains (CLinks signs DKIM itself); without it they go out from MAIL_FROM.
# SMTP_RELAY_URL=smtp://localhost:1025
# MAIL_SPF_INCLUDE=_spf.clinks.ch
# The outbox worker sends workspaces' mails; set false on every instance but one.
# MAIL_WORKER=true
# MAIL_RATE_PER_SECOND=5
# Browsers send Secure cookies to http://localhost too; set false only for other plain-HTTP hosts.
# COOKIE_SECURE=true
# A stable signing key (`pnpm --filter @clinks/api keys`); without it tokens end with each restart.
# SIGNING_KEY='{"kty":"OKP","crv":"Ed25519",...}'
# Public keys being rotated out, still accepted until their tokens expire.
# PREVIOUS_PUBLIC_KEYS='[]'
# Object storage uses AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY (or an SDK credential provider).
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=clinks-local-documents
# S3_REGION=us-east-1
# Provisioning-only: S3_LOCK_MODE, S3_RETENTION_DAYS and optional S3_NONCURRENT_DAYS.
# Stripe sandbox or live configuration must all come from the same account and mode.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICES=  # JSON from node apps/api/src/billing-catalog.ts
# STRIPE_TAX=false
# Encrypts tenants' own S3 secrets (32 bytes, base64; `pnpm --filter @clinks/api keys`). Required in production;
# without it a key is generated per start and saved tenant secrets must be entered again after a restart.
# STORAGE_SECRET_KEY=
# Development only: lets a tenant's storage point at the local RustFS (http://localhost:9000). Never in production.
# STORAGE_ALLOW_INTERNAL=true
