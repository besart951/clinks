# Copy to apps/api/.env for `pnpm dev:api`. Every value has a development default (src/config.ts).
# DATABASE_URL=postgres://clinks_api:clinks-api-dev@localhost:5432/clinks
# WEB_ORIGIN=http://localhost:5176
# SMTP_URL=smtp://localhost:1025
# Browsers send Secure cookies to http://localhost too; set false only for other plain-HTTP hosts.
# COOKIE_SECURE=true
# A stable signing key (`pnpm --filter @clinks/api keys`); without it tokens end with each restart.
# SIGNING_KEY='{"kty":"OKP","crv":"Ed25519",...}'
# Public keys being rotated out, still accepted until their tokens expire.
# PREVIOUS_PUBLIC_KEYS='[]'
# Object storage uses AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY (or an SDK credential provider).
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=clinks-local-documents
# S3_REGION=us-east-1
# Provisioning-only: S3_LOCK_MODE, S3_RETENTION_DAYS and optional S3_NONCURRENT_DAYS.
# Stripe sandbox or live configuration must all come from the same account and mode.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICES=  # JSON from node apps/api/src/billing-catalog.ts
# STRIPE_TAX=false
