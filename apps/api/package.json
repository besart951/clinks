{
  "name": "@clinks/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/main.ts",
    "start": "node src/main.ts",
    "keys": "node src/generate-key.ts",
    "openapi": "node src/openapi.ts",
    "ops:check": "node src/ops-check.ts",
    "check": "tsc --noEmit -p .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1175.0",
    "@aws-sdk/s3-request-presigner": "3.1175.0",
    "@clinks/contracts": "workspace:*",
    "@clinks/db": "workspace:*",
    "@clinks/domain": "workspace:*",
    "@clinks/i18n-types": "workspace:*",
    "@clinks/sync-schema": "workspace:*",
    "@hono/node-server": "2.1.11",
    "@hono/zod-openapi": "1.6.3",
    "@node-rs/argon2": "2.2.2",
    "@oslojs/encoding": "1.1.0",
    "@oslojs/otp": "1.1.0",
    "hono": "4.13.19",
    "jose": "6.2.18",
    "kysely": "0.29.9",
    "nodemailer": "10.6.1",
    "stripe": "23.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
